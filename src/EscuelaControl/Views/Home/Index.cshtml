@model DashboardVm
@{ ViewData["Title"] = "Resumen"; }
<div class="page-heading"><div><span class="eyebrow">VISTA GENERAL</span><h1>Tu comunidad escolar</h1><p>Lo esencial para empezar el día, en un solo lugar.</p></div><a class="button primary" asp-controller="Alumnos" asp-action="Create">+ Registrar alumno</a></div>
<section class="hero"><div><span class="eyebrow light">ADMINISTRAR TAMBIÉN ES ACOMPAÑAR</span><h2>Cada alumno,<br /><em>bien acompañado.</em></h2><p>Conecta sus datos escolares con las personas que están detrás de su aprendizaje.</p><a asp-controller="Familias" asp-action="Create" class="button cream">Registrar una familia <span>↗</span></a></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-card art-family"><span>01 / EL APOYO</span><strong>Familia</strong><i>Personas que acompañan</i></div><div class="art-card art-school"><span>03 / EL ENTORNO</span><strong>Escuela</strong><i>Un lugar para crecer</i></div><div class="art-card art-student"><span>02 / EL CENTRO</span><strong>Alumno</strong><i>Cada historia cuenta</i></div></div></section>
<section class="metrics" aria-label="Indicadores">
    <a class="metric" asp-controller="Alumnos" asp-action="Index" asp-route-estado="activo"><span>Alumnos activos <b>↗</b></span><strong>@Model.AlumnosActivos.ToString("N0")</strong><small>Expedientes en seguimiento</small></a>
    <a class="metric" asp-controller="Familias" asp-action="Index"><span>Familias registradas <b>↗</b></span><strong>@Model.Familias.ToString("N0")</strong><small>Una red de apoyo compartida</small></a>
    <a class="metric" asp-controller="Escuelas" asp-action="Index"><span>Escuelas activas <b>↗</b></span><strong>@Model.EscuelasActivas.ToString("N0")</strong><small>Planteles de tu institución</small></a>
    <a class="metric warm" asp-controller="Familias" asp-action="Index" asp-route-sinContacto="true"><span>Contactos pendientes <b>↗</b></span><strong>@Model.SinContacto.ToString("N0")</strong><small>Familias sin teléfono ni correo</small></a>
</section>
<div class="dashboard-grid">
    <section class="panel"><div class="panel-heading"><div><span class="eyebrow">EXPEDIENTES</span><h3>Últimos alumnos registrados</h3></div><a class="text-link" asp-controller="Alumnos" asp-action="Index">Ver todos →</a></div>
    @if (Model.Recientes.Count == 0) { <div class="empty"><h3>Tu comunidad empieza aquí</h3><p>Registra primero una escuela y una familia. Después agrega a sus alumnos.</p><a class="button primary" asp-controller="Escuelas" asp-action="Create">Registrar escuela</a></div> }
    else { <div class="table-wrap"><table><thead><tr><th>Alumno</th><th>Escuela</th><th>Estado</th></tr></thead><tbody>@foreach (var a in Model.Recientes) { <tr><td><a class="record-link" asp-controller="Alumnos" asp-action="Details" asp-route-id="@a.Id">@a.NombreCompleto</a><small class="block mono">@a.Matricula</small></td><td>@a.Escuela.Nombre<small class="block">@a.Grado · Grupo @a.Grupo</small></td><td><span class="badge @(a.Activo ? "green" : "gray")">@(a.Activo ? "Activo" : "Inactivo")</span></td></tr> }</tbody></table></div> }
    </section>
    <section class="panel school-overview"><div class="panel-heading"><div><span class="eyebrow">DISTRIBUCIÓN</span><h3>Alumnos por escuela</h3></div></div>@foreach (var e in Model.PorEscuela) { <div class="school-count"><div><span class="school-icon">▤</span><strong>@e.Nombre</strong></div><b>@e.Alumnos</b></div> }@if (Model.PorEscuela.Count == 0) { <div class="empty"><p>Aquí verás los alumnos activos de cada plantel.</p></div> }<a class="text-link panel-link" asp-controller="Escuelas" asp-action="Index">Administrar escuelas →</a></section>
</div>
