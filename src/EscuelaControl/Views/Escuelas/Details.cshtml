@model Escuela
@{ ViewData["Title"] = "Ficha de escuela"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Escuelas</a><span class="eyebrow">@Model.Clave</span><h1>@Model.Nombre</h1><span class="badge @(Model.Activa ? "green" : "gray")">@(Model.Activa ? "Activa" : "Inactiva")</span></div><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id">Editar escuela</a></div>
<section class="panel padded"><dl class="detail-list"><dt>Nivel educativo</dt><dd>@Model.Nivel</dd><dt>Teléfono</dt><dd>@(Model.Telefono ?? "Sin registrar")</dd><dt>Dirección</dt><dd>@(Model.Direccion ?? "Sin registrar")</dd><dt>Alumnos vinculados</dt><dd>@ViewData["Alumnos"]</dd></dl><a class="button subtle" asp-controller="Alumnos" asp-action="Index" asp-route-escuelaId="@Model.Id">Ver alumnos de esta escuela →</a></section><div class="danger-link"><a asp-action="Delete" asp-route-id="@Model.Id">Eliminar escuela</a><span>Solo se pueden eliminar escuelas sin alumnos vinculados.</span></div>
