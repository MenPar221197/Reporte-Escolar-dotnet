@model FamiliaForm
@{ ViewData["Title"] = Model.Id == 0 ? "Registrar familia" : "Editar familia"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Familias</a><h1>@ViewData["Title"]</h1><p>Registra al menos a la madre, al padre o a un tutor. Los demás campos son opcionales.</p></div></div>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post" class="panel form-panel"><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation" role="alert"></div> }
<div class="form-section"><span class="step-number">01</span><div><h3>Personas de contacto</h3><p>Completa únicamente los datos que correspondan a esta familia.</p></div></div>
<div class="form-grid"><div class="field"><label asp-for="NombrePapa"></label><input asp-for="NombrePapa" maxlength="100" /></div><div class="field"><label asp-for="TelefonoPapa"></label><input asp-for="TelefonoPapa" type="tel" maxlength="20" /><span asp-validation-for="TelefonoPapa"></span></div><div class="field"><label asp-for="NombreMama"></label><input asp-for="NombreMama" maxlength="100" /></div><div class="field"><label asp-for="TelefonoMama"></label><input asp-for="TelefonoMama" type="tel" maxlength="20" /><span asp-validation-for="TelefonoMama"></span></div><div class="field"><label asp-for="NombreTutor"></label><input asp-for="NombreTutor" maxlength="100" /></div><div class="field"><label asp-for="TelefonoTutor"></label><input asp-for="TelefonoTutor" type="tel" maxlength="20" /><span asp-validation-for="TelefonoTutor"></span></div></div>
<div class="form-section"><span class="step-number">02</span><div><h3>Comunicación</h3><p>Un correo y notas breves ayudan a mantener el contacto actualizado.</p></div></div>
<div class="form-grid"><div class="field"><label asp-for="EmailContacto"></label><input asp-for="EmailContacto" type="email" maxlength="150" /><span asp-validation-for="EmailContacto"></span></div><div class="field full"><label asp-for="Notas"></label><textarea asp-for="Notas" rows="3" maxlength="500" placeholder="Ej. Horario preferido para recibir llamadas."></textarea><small class="hint">Evita incluir información médica, documentos de identidad o datos que no sean necesarios para el contacto escolar.</small></div></div>
<div class="form-actions"><button type="submit" class="button primary">Guardar familia</button><a class="button subtle" asp-action="Index">Cancelar</a></div></form>
