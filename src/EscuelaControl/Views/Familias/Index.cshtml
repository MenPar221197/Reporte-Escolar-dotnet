@model PagedList<FamiliaFila>
@{ ViewData["Title"] = "Familias"; var sinContacto = (bool)(ViewData["SinContacto"] ?? false); }
<div class="page-heading"><div><span class="eyebrow">LA RED DE APOYO</span><h1>Familias</h1><p>Un registro por familia, todos sus hijos conectados.</p></div><a class="button primary" asp-action="Create">+ Registrar familia</a></div>
<section class="panel"><form method="get" class="filters"><div class="field search-field"><label for="q">Buscar familiar</label><input id="q" name="q" value="@ViewData["Q"]" maxlength="120" placeholder="Padre, madre, tutor o correo…" /></div><label class="check filter-check"><input type="checkbox" name="sinContacto" value="true" checked="@sinContacto" /> Sin teléfono ni correo</label><button class="button primary" type="submit">Buscar</button><a class="text-link" asp-action="Index">Limpiar</a></form>
@if (Model.Items.Count == 0) { <div class="empty"><h3>No hay familias para mostrar</h3><p>Registra una familia o cambia los filtros.</p><a class="button subtle" asp-action="Create">Registrar familia</a></div> }
else { <div class="table-wrap"><table><thead><tr><th>Familia</th><th>Padre</th><th>Madre</th><th>Tutor o tutora</th><th>Hijos</th><th>Acciones</th></tr></thead><tbody>@foreach (var f in Model.Items) { <tr><td><a class="record-link mono" asp-action="Details" asp-route-id="@f.Id">F-@f.Id.ToString("000")</a></td><td>@(f.NombrePapa ?? "—")<small class="block">@f.TelefonoPapa</small></td><td>@(f.NombreMama ?? "—")<small class="block">@f.TelefonoMama</small></td><td>@(f.NombreTutor ?? "—")<small class="block">@f.TelefonoTutor</small></td><td>@f.Hijos</td><td><a class="text-link" asp-action="Edit" asp-route-id="@f.Id">Editar</a></td></tr> }</tbody></table></div> }
<partial name="_Pagination" model="new PaginationVm(Model.Page, Model.Pages, Model.Total)" /></section>
