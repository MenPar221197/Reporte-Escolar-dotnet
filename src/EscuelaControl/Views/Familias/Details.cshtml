@model Familia
@{ ViewData["Title"] = "Ficha de familia"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Familias</a><span class="eyebrow">F-@Model.Id.ToString("000")</span><h1>Una familia, varias historias</h1><p>@Model.Referencia</p></div><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id">Editar contactos</a></div>
<section class="panel padded"><div class="contact-grid"><div><span class="eyebrow">PADRE</span><h3>@(Model.NombrePapa ?? "Sin registrar")</h3><p>@(Model.TelefonoPapa ?? "Sin teléfono")</p></div><div><span class="eyebrow">MADRE</span><h3>@(Model.NombreMama ?? "Sin registrar")</h3><p>@(Model.TelefonoMama ?? "Sin teléfono")</p></div><div><span class="eyebrow">TUTOR O TUTORA</span><h3>@(Model.NombreTutor ?? "Sin registrar")</h3><p>@(Model.TelefonoTutor ?? "Sin teléfono")</p></div></div><dl><dt>Correo de contacto</dt><dd>@(Model.EmailContacto ?? "Sin registrar")</dd><dt>Notas</dt><dd class="preserve-lines">@(Model.Notas ?? "Sin notas")</dd></dl></section>
<section class="panel spaced"><div class="panel-heading"><div><span class="eyebrow">EXPEDIENTES VINCULADOS</span><h3>Hijos de esta familia</h3></div><a class="button subtle small" asp-controller="Alumnos" asp-action="Create" asp-route-familiaId="@Model.Id">+ Agregar alumno</a></div>@if (Model.Alumnos.Count == 0) { <div class="empty"><p>Esta familia todavía no tiene alumnos vinculados.</p></div> }else { <div class="table-wrap"><table><thead><tr><th>Alumno</th><th>Matrícula</th><th>Escuela</th><th>Grado / grupo</th></tr></thead><tbody>@foreach (var a in Model.Alumnos.OrderBy(a => a.NombreCompleto)) { <tr><td><a class="record-link" asp-controller="Alumnos" asp-action="Details" asp-route-id="@a.Id">@a.NombreCompleto</a></td><td class="mono">@a.Matricula</td><td>@a.Escuela.Nombre</td><td>@a.Grado · @a.Grupo</td></tr> }</tbody></table></div> }</section>
<div class="danger-link"><a asp-action="Delete" asp-route-id="@Model.Id">Eliminar familia</a><span>Solo se pueden eliminar familias sin alumnos vinculados.</span></div>
