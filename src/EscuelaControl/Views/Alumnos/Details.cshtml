@model Alumno
@{ ViewData["Title"] = "Expediente del alumno"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Alumnos</a><span class="eyebrow">@Model.Matricula</span><h1>@Model.NombreCompleto</h1><span class="badge @(Model.Activo ? "green" : "gray")">@(Model.Activo ? "Activo" : "Inactivo")</span></div><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id">Editar expediente</a></div>
<div class="detail-grid"><section class="panel padded"><span class="eyebrow">DATOS ESCOLARES</span><h3>Su lugar en la escuela</h3><dl><dt>Escuela</dt><dd><a asp-controller="Escuelas" asp-action="Details" asp-route-id="@Model.EscuelaId">@Model.Escuela.Nombre</a></dd><dt>Grado y grupo</dt><dd>@Model.Grado · @Model.Grupo</dd><dt>Fecha de nacimiento</dt><dd>@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd><dt>Registro</dt><dd>@Model.CreadoUtc.ToString("dd/MM/yyyy")</dd></dl></section><section class="panel padded"><span class="eyebrow">SU RED DE APOYO</span><h3>Familia y contacto</h3><dl><dt>Padre</dt><dd>@(Model.Familia.NombrePapa ?? "Sin registrar")<small class="block">@Model.Familia.TelefonoPapa</small></dd><dt>Madre</dt><dd>@(Model.Familia.NombreMama ?? "Sin registrar")<small class="block">@Model.Familia.TelefonoMama</small></dd><dt>Tutor o tutora</dt><dd>@(Model.Familia.NombreTutor ?? "Sin registrar")<small class="block">@Model.Familia.TelefonoTutor</small></dd><dt>Correo</dt><dd>@(Model.Familia.EmailContacto ?? "Sin registrar")</dd></dl><a class="text-link" asp-controller="Familias" asp-action="Details" asp-route-id="@Model.FamiliaId">Ver familia completa →</a></section></div>
<div class="danger-link"><a asp-action="Delete" asp-route-id="@Model.Id">Eliminar este registro</a><span>Para una baja escolar, conserva el expediente marcándolo como inactivo.</span></div>
