@model AlumnoForm
@{ ViewData["Title"] = Model.Id == 0 ? "Registrar alumno" : "Editar alumno"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Alumnos</a><h1>@ViewData["Title"]</h1><p>Completa el expediente y selecciona su familia y escuela.</p></div></div>
@if (!Model.Familias.Any() || !Model.Escuelas.Any()) { <div class="notice">Para registrar alumnos necesitas <a asp-controller="Familias" asp-action="Create">una familia</a> y <a asp-controller="Escuelas" asp-action="Create">una escuela activa</a>.</div> }
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post" class="panel form-panel">
<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation" role="alert"></div> }
<div class="form-section"><span class="step-number">01</span><div><h3>Datos del alumno</h3><p>La matrícula identifica a cada alumno de forma única.</p></div></div>
<div class="form-grid"><div class="field"><label asp-for="Matricula"></label><input asp-for="Matricula" placeholder="Ej. ALU-2026-001" maxlength="20" required /><span asp-validation-for="Matricula"></span></div><div class="field"><label asp-for="NombreCompleto"></label><input asp-for="NombreCompleto" maxlength="120" required /><span asp-validation-for="NombreCompleto"></span></div><div class="field"><label asp-for="FechaNacimiento"></label><input asp-for="FechaNacimiento" type="date" required /><span asp-validation-for="FechaNacimiento"></span></div><div class="field"><label asp-for="Grado"></label><input asp-for="Grado" placeholder="Ej. 3.º de primaria" maxlength="30" required /></div><div class="field"><label asp-for="Grupo"></label><input asp-for="Grupo" placeholder="Ej. A" maxlength="15" required /></div></div>
<div class="form-section"><span class="step-number">02</span><div><h3>Familia y escuela</h3><p>Los hermanos pueden compartir el mismo registro familiar.</p></div></div>
<div class="form-grid"><div class="field"><label asp-for="FamiliaId"></label><select asp-for="FamiliaId" asp-items="Model.Familias" required><option value="">Selecciona una familia</option></select><span asp-validation-for="FamiliaId"></span></div><div class="field"><label asp-for="EscuelaId"></label><select asp-for="EscuelaId" asp-items="Model.Escuelas" required><option value="">Selecciona una escuela</option></select><span asp-validation-for="EscuelaId"></span></div></div>
<label class="check"><input asp-for="Activo" /> Alumno activo</label><p class="hint">Desmarca esta opción para una baja escolar y conserva el expediente.</p>
<div class="form-actions"><button class="button primary" type="submit">Guardar alumno</button><a class="button subtle" asp-action="Index">Cancelar</a></div>
</form>
