@model PagedList<Alumno>
@{ ViewData["Title"] = "Alumnos"; var estado = ViewData["Estado"]?.ToString(); }
<div class="page-heading"><div><span class="eyebrow">EXPEDIENTES ESCOLARES</span><h1>Alumnos</h1><p>Sus datos, su familia y su escuela, siempre vinculados.</p></div><a class="button primary" asp-action="Create">+ Registrar alumno</a></div>
<section class="panel">
<form method="get" class="filters"><div class="field search-field"><label for="q">Buscar alumno o familiar</label><input id="q" name="q" value="@ViewData["Q"]" placeholder="Nombre, matrícula o familiar…" maxlength="120" /></div><div class="field"><label for="escuelaId">Escuela</label><select id="escuelaId" name="escuelaId" asp-items="ViewBag.Escuelas"><option value="">Todas las escuelas</option></select></div><div class="field"><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><option value="activo" selected="@(estado == "activo")">Activo</option><option value="inactivo" selected="@(estado == "inactivo")">Inactivo</option></select></div><button class="button primary" type="submit">Filtrar</button><a class="text-link" asp-action="Index">Limpiar</a></form>
<div class="list-heading"><span>@Model.Total alumnos encontrados</span><a class="button subtle small" asp-action="Exportar" asp-route-q="@ViewData["Q"]" asp-route-escuelaId="@ViewData["EscuelaId"]" asp-route-estado="@estado">↓ Exportar CSV</a></div>
@if (Model.Items.Count == 0) { <div class="empty"><h3>No hay alumnos para mostrar</h3><p>Prueba otra búsqueda o registra un alumno nuevo.</p><a class="button subtle" asp-action="Create">Registrar alumno</a></div> }
else { <div class="table-wrap"><table><thead><tr><th>Alumno / matrícula</th><th>Escuela / grupo</th><th>Familia</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach (var a in Model.Items) { <tr><td><a class="record-link" asp-action="Details" asp-route-id="@a.Id">@a.NombreCompleto</a><small class="block mono">@a.Matricula</small></td><td>@a.Escuela.Nombre<small class="block">@a.Grado · @a.Grupo</small></td><td><a asp-controller="Familias" asp-action="Details" asp-route-id="@a.FamiliaId">@a.Familia.Referencia</a></td><td><span class="badge @(a.Activo ? "green" : "gray")">@(a.Activo ? "Activo" : "Inactivo")</span></td><td><a class="text-link" asp-action="Edit" asp-route-id="@a.Id">Editar</a></td></tr> }</tbody></table></div> }
<partial name="_Pagination" model="new PaginationVm(Model.Page, Model.Pages, Model.Total)" />
</section>
